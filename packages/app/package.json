{
  "name": "@pocket-bots/app",
  "version": "0.1.0",
  "private": true,
  "description": "Personal bots that run on your own coding-agent CLIs: instructions, a model, memory, routines, group chats, skills, MCP tools and connected apps.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --clear-screen=false src/server/main.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "start": "tsx src/server/main.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "service": "tsx src/server/service-cli.ts"
  },
  "dependencies": {
    "@pocket-bots/runtime": "*",
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "tsx": "^4.23.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.4"
  }
}
